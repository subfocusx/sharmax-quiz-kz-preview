# Автогенерация: scripts/build-static.mjs
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Content-Security-Policy "frame-ancestors 'self' https://globaldrive.by https://globaldrive.kz https://www.globaldrive.by https://www.globaldrive.kz"
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|webp|avif|svg|ico)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
</IfModule>
